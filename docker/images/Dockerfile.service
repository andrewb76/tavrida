# Multi-stage NestJS service image for monorepo (pnpm + turbo).
#
# Build:
#   docker build -f docker/images/Dockerfile.service \
#     --build-arg SERVICE_PKG=@tavrida/bff \
#     --build-arg SERVICE_DIR=services/bff \
#     -t ghcr.io/<owner>/tavrida-bff:<tag> .
#
# SERVICE_PKG — pnpm package name (@tavrida/*)
# SERVICE_DIR — path to service directory (dist/main.js relative to deploy root)

ARG SERVICE_PKG=@tavrida/bff
ARG SERVICE_DIR=services/bff

FROM node:22-alpine AS build
ARG SERVICE_PKG
ARG SERVICE_DIR

RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY tools ./tools
COPY services ./services
COPY config ./config
COPY e2e/package.json ./e2e/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts \
  && pnpm rebuild esbuild @nestjs/core core-js \
  && pnpm exec turbo run build --filter=${SERVICE_PKG}... --force

# --- Assemble /deploy ---
# 1. Copy built service dist + package.json.
# 2. Collect external production deps reachable from the service's dependency tree only.
# 3. Install with npm (flat node_modules, no symlinks, no workspace junk).
# 4. Copy workspace package dist into node_modules/@tavrida/*.
ARG SERVICE_DIR
RUN mkdir -p /deploy && cp -r /repo/${SERVICE_DIR}/dist /deploy/dist && cp /repo/${SERVICE_DIR}/package.json /deploy/package.json
RUN cd /deploy && node -e " \
  const fs=require('fs'),p=require('path'); \
  const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); \
  const ws=new Map(); \
  for(const d of fs.readdirSync('/repo/packages',{withFileTypes:true})){ \
    if(!d.isDirectory())continue; \
    const dir=p.join('/repo/packages',d.name); \
    const pj=p.join(dir,'package.json'); \
    if(!fs.existsSync(pj))continue; \
    const m=JSON.parse(fs.readFileSync(pj,'utf8')); \
    ws.set(m.name,{dir,deps:m.dependencies||{}}); \
  } \
  const wsNames=new Set(ws.keys()); \
  const all={}; \
  const visited=new Set(); \
  const add=(name,version)=>{ \
    if(visited.has(name))return; \
    visited.add(name); \
    if(!wsNames.has(name)){ \
      if(version)all[name]=version; \
      return; \
    } \
    const w=ws.get(name); \
    if(!w)return; \
    for(const[n,v] of Object.entries(w.deps))add(n,v); \
  }; \
  for(const[n,v] of Object.entries(pkg.dependencies||{}))add(n,v); \
  fs.writeFileSync('package.json',JSON.stringify({name:pkg.name,version:'0.0.0',private:true,dependencies:all},null,2)); \
  console.log('Installing',Object.keys(all).length,'external deps (transitive from service only)');" && npm install --omit=dev --ignore-scripts 2>&1 && rm -f package.json package-lock.json
RUN cd /deploy && node -e " \
  const fs=require('fs'),p=require('path'); \
  const origPkg=JSON.parse(fs.readFileSync('/repo/${SERVICE_DIR}/package.json','utf8')); \
  const ws=new Map(); \
  for(const d of fs.readdirSync('/repo/packages',{withFileTypes:true})){ \
    if(!d.isDirectory())continue; \
    const dir=p.join('/repo/packages',d.name); \
    const pj=p.join(dir,'package.json'); \
    if(!fs.existsSync(pj))continue; \
    const m=JSON.parse(fs.readFileSync(pj,'utf8')); \
    ws.set(m.name,{dir,deps:m.dependencies||{}}); \
  } \
  const needed=new Set(); \
  const walk=(deps)=>{for(const[n] of Object.entries(deps||{})){if(!needed.has(n)){needed.add(n);const w=ws.get(n);if(w)walk(w.deps)}}}; \
  walk(origPkg.dependencies); \
  for(const[name,w] of ws){ \
    if(!needed.has(name))continue; \
    const dest=p.join('/deploy/node_modules',name); \
    fs.mkdirSync(dest,{recursive:true}); \
    const dist=p.join(w.dir,'dist'); \
    if(fs.existsSync(dist))fs.cpSync(dist,p.join(dest,'dist'),{recursive:true}); \
    fs.copyFileSync(p.join(w.dir,'package.json'),p.join(dest,'package.json')); \
    console.log('copied',name); \
  }"

FROM node:22-alpine AS runtime
ARG SERVICE_DIR

RUN addgroup -S tavrida && adduser -S -G tavrida tavrida
USER tavrida

WORKDIR /app
COPY --from=build --chown=tavrida:tavrida /deploy ./
COPY --from=build --chown=tavrida:tavrida /repo/config ./config

ENV NODE_ENV=production

CMD ["node", "dist/main.js"]
