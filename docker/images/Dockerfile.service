# Multi-stage NestJS service image for monorepo (pnpm + turbo).
#
# Build:
#   docker build -f docker/images/Dockerfile.service \
#     --build-arg SERVICE_PKG=@tavrida/bff \
#     --build-arg SERVICE_DIR=services/bff \
#     -t ghcr.io/<owner>/tavrida-bff:<tag> .
#
# SERVICE_PKG — pnpm package name (@tavrida/*)
# SERVICE_DIR — path to service directory (dist/main.js relative to deploy root)

ARG SERVICE_PKG=@tavrida/bff
ARG SERVICE_DIR=services/bff

FROM node:22-alpine AS build
ARG SERVICE_PKG
ARG SERVICE_DIR

RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY tools ./tools
COPY services ./services
COPY config ./config
COPY e2e/package.json ./e2e/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts \
  && pnpm rebuild esbuild @nestjs/core core-js \
  && pnpm exec turbo run build --filter=${SERVICE_PKG}...

# --- Assemble /deploy ---
# 1. Copy built service dist + package.json.
# 2. Collect ALL external production deps (service deps + workspace package deps).
# 3. Install with npm (flat node_modules, no symlinks, no workspace junk).
# 4. Copy workspace package dist into node_modules/@tavrida/*.
ARG SERVICE_DIR
RUN mkdir -p /deploy && cp -r /repo/${SERVICE_DIR}/dist /deploy/dist && cp /repo/${SERVICE_DIR}/package.json /deploy/package.json
RUN cd /deploy && node -e "const fs=require('fs'),p=require('path');const pkg=JSON.parse(fs.readFileSync('package.json','utf8'));const ws=new Map();for(const d of fs.readdirSync('/repo/packages',{withFileTypes:true})){if(!d.isDirectory())continue;const dir=p.join('/repo/packages',d.name);const pj=p.join(dir,'package.json');if(!fs.existsSync(pj))continue;const m=JSON.parse(fs.readFileSync(pj,'utf8'));ws.set(m.name,{dir,deps:m.dependencies||{}});}const wsNames=new Set(ws.keys());const all={};const add=(deps)=>{for(const[n,v] of Object.entries(deps||{}))if(!wsNames.has(n)&&!all[n])all[n]=v;};add(pkg.dependencies);for(const{deps} of ws.values())add(deps);fs.writeFileSync('package.json',JSON.stringify({name:pkg.name,version:'0.0.0',private:true,dependencies:all},null,2));console.log('Installing',Object.keys(all).length,'external deps');" && npm install --omit=dev --ignore-scripts 2>&1 && rm -f package.json package-lock.json
RUN cd /deploy && node -e "const fs=require('fs'),p=require('path');for(const d of fs.readdirSync('/repo/packages',{withFileTypes:true})){if(!d.isDirectory())continue;const dir=p.join('/repo/packages',d.name);const pj=p.join(dir,'package.json');if(!fs.existsSync(pj))continue;const name=JSON.parse(fs.readFileSync(pj,'utf8')).name;const dest=p.join('/deploy/node_modules',name);fs.mkdirSync(dest,{recursive:true});const dist=p.join(dir,'dist');if(fs.existsSync(dist))fs.cpSync(dist,p.join(dest,'dist'),{recursive:true});fs.copyFileSync(pj,p.join(dest,'package.json'));console.log('copied',name);}"

FROM node:22-alpine AS runtime
ARG SERVICE_DIR

RUN addgroup -S tavrida && adduser -S -G tavrida tavrida
USER tavrida

WORKDIR /app
COPY --from=build --chown=tavrida:tavrida /deploy ./
COPY --from=build --chown=tavrida:tavrida /repo/config ./config

ENV NODE_ENV=production

CMD ["node", "dist/main.js"]
