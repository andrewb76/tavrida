# Multi-stage NestJS service image for monorepo (pnpm + turbo).
#
# Build:
#   docker build -f docker/images/Dockerfile.service \
#     --build-arg SERVICE_PKG=@tavrida/bff \
#     --build-arg SERVICE_DIR=services/bff \
#     -t ghcr.io/<owner>/tavrida-bff:<tag> .
#
# SERVICE_PKG — pnpm package name (@tavrida/*)
# SERVICE_DIR — path to service directory (dist/main.js relative to deploy root)

ARG SERVICE_PKG=@tavrida/bff
ARG SERVICE_DIR=services/bff

FROM node:22-alpine AS build
ARG SERVICE_PKG
ARG SERVICE_DIR

RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY tools ./tools
COPY services ./services
COPY config ./config
COPY e2e/package.json ./e2e/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts \
  && pnpm rebuild esbuild @nestjs/core core-js \
  && pnpm exec turbo run build --filter=${SERVICE_PKG}...

# --- Assemble /deploy (avoids pnpm deploy workspace symlink issues) ---
# 1. Copy built service dist.
# 2. Collect external production deps (service + workspace packages).
# 3. Install with npm (flat node_modules, no symlinks).
# 4. Copy workspace package dist into node_modules/@tavrida/*.
ARG SERVICE_DIR
RUN mkdir -p /deploy \
  && cp -r /repo/${SERVICE_DIR}/dist /deploy/dist \
  && cp /repo/${SERVICE_DIR}/package.json /deploy/package.json \
  && cd /deploy \
  && node -e "
const fs = require('fs'), path = require('path');
const pkg = JSON.parse(fs.readFileSync('package.json','utf8'));
const wsDirs = fs.readdirSync('/repo/packages',{withFileTypes:true})
  .filter(d=>d.isDirectory()).map(d=>path.join('/repo/packages',d.name));
const wsPkgs = new Map();
for (const dir of wsDirs) {
  const pj = path.join(dir,'package.json');
  if (fs.existsSync(pj)) { const p=JSON.parse(fs.readFileSync(pj,'utf8')); wsPkgs.set(p.name,{dir,deps:p.dependencies||{}}); }
}
const wsNames = new Set(wsPkgs.keys());
const allDeps = {};
const add = (deps) => { for (const [n,v] of Object.entries(deps||{})) if (!wsNames.has(n) && !allDeps[n]) allDeps[n]=v; };
add(pkg.dependencies);
for (const [,info] of wsPkgs) add(info.deps);
fs.writeFileSync('package.json', JSON.stringify({name:pkg.name,version:'0.0.0',private:true,dependencies:allDeps},null,2));
console.log('Installing',Object.keys(allDeps).length,'external deps');
" \
  && npm install --omit=dev --ignore-scripts 2>&1 \
  && rm -f package.json package-lock.json

# Copy workspace package dist artifacts into node_modules/@tavrida/*.
# Only copies dist/ and package.json — external deps were installed above via npm.
RUN cd /deploy && node -e "
const fs=require('fs'),path=require('path');
for(const d of fs.readdirSync('/repo/packages',{withFileTypes:true})){
  if(!d.isDirectory())continue;
  const dir=path.join('/repo/packages',d.name);
  const pj=path.join(dir,'package.json');
  if(!fs.existsSync(pj))continue;
  const name=JSON.parse(fs.readFileSync(pj,'utf8')).name;
  const dest=path.join('/deploy/node_modules',name);
  fs.mkdirSync(dest,{recursive:true});
  const dist=path.join(dir,'dist');
  if(fs.existsSync(dist))fs.cpSync(dist,path.join(dest,'dist'),{recursive:true});
  fs.copyFileSync(pj,path.join(dest,'package.json'));
  console.log('copied',name);
}
"

FROM node:22-alpine AS runtime
ARG SERVICE_DIR

RUN addgroup -S tavrida && adduser -S -G tavrida tavrida
USER tavrida

WORKDIR /app
COPY --from=build --chown=tavrida:tavrida /deploy ./
COPY --from=build --chown=tavrida:tavrida /repo/config ./config

ENV NODE_ENV=production

CMD ["node", "dist/main.js"]
