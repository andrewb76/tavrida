# Admin SPA — static nginx image.
#
# Build:
#   docker build -f docker/images/Dockerfile.admin \
#     --build-arg VITE_API_BASE_URL=https://api.evatorg.su/api/v1 \
#     -t ghcr.io/<owner>/tavrida-admin:<tag> .

FROM node:22-alpine AS build

ARG VITE_API_BASE_URL

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps/admin ./apps/admin
COPY tools ./tools
COPY e2e/package.json ./e2e/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts \
  && pnpm rebuild esbuild \
  && pnpm exec turbo run build --filter=@tavrida/admin

FROM nginx:1.27-alpine AS runtime
COPY docker/images/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/admin/dist /usr/share/nginx/html
