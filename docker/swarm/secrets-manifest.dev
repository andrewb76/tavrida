# Swarm secret manifest (dev) → tavrida_dev_<name>
#
# Raw values from dev.secrets.env:
POSTGRES_PASSWORD
RABBITMQ_PASSWORD
MINIO_ROOT_PASSWORD
LOGTO_M2M_APP_SECRET
INTERNAL_SERVICE_TOKEN
HAWK_TOKEN
# Grafana Cloud Access Policy token (metrics:write, logs:write, traces:write)
# Optional until Alloy enabled — empty value is skipped by sync-secrets-dev.sh
GRAFANA_CLOUD_TOKEN
#
# Computed in sync-secrets-dev.sh (needs dev.env + dev.secrets.env):
#   rabbitmq_url, *_database_url (incl. chat_database_url)
