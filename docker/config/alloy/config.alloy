// Grafana Alloy → Grafana Cloud (dev)
// Credentials: env URLs/usernames + Swarm secret grafana_cloud_token
// Docs: docs/07-observability/grafana-setup.md
//
// Metrics + logs only. Traces (OTLP → Tempo) stay out of this file until
// GRAFANA_CLOUD_OTLP_ENDPOINT is reliably set in every deploy — an empty
// endpoint crashes the whole Alloy process (metrics/logs die with it).

local.file "grafana_cloud_token" {
  filename  = "/run/secrets/grafana_cloud_token"
  is_secret = true
}

// --- Docker discovery (logs + cAdvisor metrics) ---

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
    target_label  = "swarm_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_stack_namespace"]
    target_label  = "stack"
  }

  rule {
    target_label = "env"
    replacement  = "dev"
  }
}

// --- Metrics: cAdvisor → Mimir ---

prometheus.exporter.cadvisor "docker" {
  docker_host = "unix:///var/run/docker.sock"

  storage_duration = "5m"
}

prometheus.scrape "cadvisor" {
  targets         = prometheus.exporter.cadvisor.docker.targets
  forward_to      = [prometheus.relabel.metrics.receiver]
  scrape_interval = "60s"
  scrape_timeout  = "10s"
}

prometheus.relabel "metrics" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    target_label = "env"
    replacement  = "dev"
  }

  rule {
    target_label = "cluster"
    replacement  = "tavrida-dev"
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USERNAME")
      password = local.file.grafana_cloud_token.content
    }
  }
}

// --- Logs: Docker stdout → Loki ---

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_containers.output
  labels     = { "env" = "dev", "cluster" = "tavrida-dev" }
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = local.file.grafana_cloud_token.content
    }
  }
}
